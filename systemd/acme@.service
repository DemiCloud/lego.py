[Unit]
Description=ACME certificate renewal for %i using lego

[Service]
Type=oneshot
WorkingDirectory=/var/lib/acme
# The ExecStart path is rewritten by 'lego.py install' to wherever lego.py
# actually lives — this copy is reference only, not deployed as-is.
ExecStart=/usr/local/bin/lego.py renew-exec %i
